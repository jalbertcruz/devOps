# private data
sudo zfs create $ZPOOL/private
sudo zfs set compression=zstd-9 $ZPOOL/private
sudo zfs set recordsize=8K $ZPOOL/private
sudo zfs set copies=3 $ZPOOL/private
sudo zfs set mountpoint=/home/$USER/$DATA_FOLDER/private $ZPOOL/private
sudo zfs set sync=standard $ZPOOL/private

# books
sudo zfs create $ZPOOL/books
sudo zfs set compression=zstd-9 $ZPOOL/books
sudo zfs set recordsize=64K $ZPOOL/books
sudo zfs set atime=off $ZPOOL/books
sudo zfs set mountpoint=/home/$USER/$DATA_FOLDER/books $ZPOOL/books
sudo zfs set sync=standard $ZPOOL/books



