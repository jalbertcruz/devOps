#!/usr/bin/env bash

if [ -z "$ZPOOL" ] || [ -z "$DATA_FOLDER" ]; then
  echo "Error: ZPOOL and DATA_FOLDER environment variables must be set."
  exit 1
fi

#ZPOOL="externo"
DISK_1_ID="usb-SanDisk_Cruzer_Blade_04020204010325234118-0:0-part1" # flash
DISK_2_ID="usb-WD_Elements_25A1_575831314442384152444E35-0:0-part3" # hdd
# ls -la /dev/disk/by-id/

#    -f \
#sudo zpool create -o cachefile=$ZPOOL_CACHE \
sudo zpool create \
    -o ashift=12 \
    -o autotrim=off \
    $ZPOOL mirror \
    /dev/disk/by-id/${DISK_1_ID} \
    /dev/disk/by-id/${DISK_2_ID}

