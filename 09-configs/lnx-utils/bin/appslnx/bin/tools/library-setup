# personal documents
sudo zfs create $ZPOOL/docs
sudo zfs set compression=zstd-9 $ZPOOL/docs
sudo zfs set recordsize=64K $ZPOOL/docs
sudo zfs set atime=off $ZPOOL/docs
sudo zfs set mountpoint=/home/$USER/$DATA_FOLDER/docs $ZPOOL/docs
