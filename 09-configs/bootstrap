  -t "$HOME" \
  logseq \
  obs-studio \
  sioyek \
  vale \
  bin

cd ../GUIs
stow \
  -t "$HOME" \
  base \
  data \
  dev \
  hobbies \
  media \
  security \
  learning \
  writing
