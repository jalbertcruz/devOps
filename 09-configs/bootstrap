  -t "$HOME" \
  jq \
  bin

cd ../dev
stow \
  -t "$HOME" \
  clojure-lsp \
  coursier \
  efm \
  lazygit \
  git \
  pnpm \
  poetry \
  sbt \
  sqlfluff \
  tree-sitter-cli \
  uv \
  bin \
  jetbrains-vim

#cd ../extra
#stow \
#  -t "$HOME"

cd ../lnx-utils
stow \
  -t "$HOME" \
  files-utils \
  ov \
  procs \
  bin

cd ../local
stow \
  -t "$HOME" \
  qmk

cd ../Ops
stow \
  -t "$HOME" \
  containers \
  direnv \
  just \
  k9s \
  qtile \
  rofi \
  bin

cd ../shells
