#!/usr/bin/env python3

from urllib.parse import urlparse, parse_qsl
import json
import sys

import subprocess

result = subprocess.run(["xclip -o -selection clipboard"], stdout=subprocess.PIPE, shell=True)
clipboard_content = result.stdout.decode('utf-8')

parsed = urlparse(clipboard_content)

query_items = {}
if len(parsed.query) != 0:
    for key, value in parse_qsl(parsed.query):
        query_items[key] = value
else:
    query_items = None

path = None
if len(parsed.path) != 0:
   path =parsed.path

fragment = None
if len(parsed.fragment) != 0:
    fragment = parsed.fragment

temp_result = dict(
    protocol=parsed.scheme,
    username=parsed.username,
    password=parsed.password,
    hostname=parsed.hostname,
    port=parsed.port,
    path=path,
    full_query=parsed.query,
    query_items=query_items,
    hash=parsed.fragment,
)

result = {}
for key in temp_result.keys():
    if temp_result[key]:
        result[key] = temp_result[key]
print(json.dumps(
    result
))
