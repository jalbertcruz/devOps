#!/usr/bin/env bash

declare -a nums=(
  0
  1
  2
  3
  4
  5
  6
)

create_networks() {
  sudo modprobe dummy
  for i in "${!nums[@]}"; do
    sudo ip link add name "mylo${nums[$i]}" type dummy
    sudo ip address add 172.16.1${nums[$i]}.65/26 dev "mylo${nums[$i]}"
    sudo ip link set dev "mylo${nums[$i]}" up
  done
}

create_networks
