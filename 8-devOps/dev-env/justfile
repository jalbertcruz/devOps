create-postgres-database:
    #!/usr/bin/env bash

    servers=$(docker ps --filter "label=type=postgres" | awk 'NR>1 {print $NF}')
    lines=$(docker ps --filter "label=type=postgres" | awk 'NR>1 {print $NF}' | wc -l)
    if [ "$lines" -eq 0 ]; then
      echo "No PostgreSQL servers found."
      exit 0
    elif [ "$lines" -eq 1 ]; then
      server=$servers
    elif [ "$lines" -gt 1 ]; then
      server=$(gum choose $servers)
    fi

    dbases=$(docker exec -i $server psql -U duser -d postgres -t -c "create database service4 owner duser;" )
    echo $dbases

