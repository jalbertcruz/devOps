fmt-py:
    ruff check --select I --fix cli
    ruff format cli

run-tests:
    fd '.*_test_*|test_*|.*_test' --exec-batch echo '{//}'\n | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^\s*$' | fzf

