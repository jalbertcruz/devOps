{
  "builders": [
    {
      "type": "docker",
      "image": "jalbert/centos:7",
      "commit": true,
      "changes": [
        "ENTRYPOINT [\"/init\"]",
        "EXPOSE 22 4000"
      ]
    }
  ],
  "provisioners": [
    {
      "type": "ansible",
      "user": "root",
      "ansible_env_vars": [
        "ANSIBLE_DISTRIBUTION=centos",
        "PYTHON_VERSION=3.8.1"
      ],
      "playbook_file": "provision-python.yml"
    }
  ],
  "post-processors": [
    [
      {
        "type": "docker-tag",
        "repository": "docker.io/jalbert/python",
        "tag": "centos7"
      }
    ]
  ]
}
